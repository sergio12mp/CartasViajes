# Neon: conexión con pool para la aplicación.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"
# Neon: conexión directa para Prisma.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Genera un secreto aleatorio y consérvalo solo en tu entorno.
AUTH_SECRET=""
# Credenciales del cliente web de Google OAuth.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Correos con acceso al panel /admin, separados por comas.
ADMIN_EMAILS=""
# Notificaciones push (Web Push). Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@example.com"
# Packs premium. Mientras PAYMENTS_ENABLED no sea "true", todos los packs están abiertos para todo el mundo (modo pruebas).
PAYMENTS_ENABLED="false"
# Stripe Checkout (solo se usa con PAYMENTS_ENABLED="true").
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# URL pública de la app, usada para volver desde Stripe.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# AUTH_URL="http://localhost:3000"
# En Vercel, configura AUTH_URL con la URL pública si tu dominio no es el predeterminado.
